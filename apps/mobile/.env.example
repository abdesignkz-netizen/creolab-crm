# Public configuration only. These values are not signing credentials.
BASQAR_APP_URL=https://bsqr.kz
# Set the real project ID after linking the existing app to your Expo account.
# BASQAR_EAS_PROJECT_ID=
# BASQAR_EXPO_OWNER=
# BASQAR_APPLE_TEAM_ID=
# Enable only after both domain-association files are published and tested.
BASQAR_VERIFIED_LINKS=0
# Path to an untracked Firebase configuration file; never commit this file.
# BASQAR_GOOGLE_SERVICES_FILE=/secure/path/google-services.json
