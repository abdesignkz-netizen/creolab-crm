NODE_ENV=development
APP_BASE_URL=http://localhost:4180
API_BASE_URL=http://localhost:4100
API_PORT=4100
ALLOWED_ORIGINS=http://localhost:4180,http://127.0.0.1:4180,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
# Production: ALLOWED_ORIGINS обязателен и не может содержать *. Указать origin кабинета.
# Перенос production на bsqr.kz: deploy/bsqr-domain.env.example и docs/domain-migration-bsqr-2026-09-25.md.
# Не включать редирект до подключения нового custom domain, DNS и HTTPS.
LEGACY_APP_ORIGIN=
LEGACY_REDIRECT_MODE=off

# PostgreSQL в проде. Пустое значение в development включает локальный PGlite.
DATABASE_URL=
# DATABASE_URL=postgresql://crm:crm@localhost:5432/creolab_crm

REDIS_URL=
# REDIS_URL=redis://localhost:6379

SESSION_SECRET=replace-with-long-random-string
ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex
# Обязателен в production. Не коммитить.
# Смена ENCRYPTION_KEY без перешифрования делает нечитаемыми WhatsApp/LLM credentials и ESF sessionId в БД.
# Ротация: 1) сгенерировать новый ключ; 2) расшифровать существующие secretBox-поля старым ключом;
# 3) зашифровать новым; 4) обновить ENCRYPTION_KEY и ENCRYPTION_KEY_VERSION; 5) удалить старый ключ.
# KMS/авто-reencrypt пока не внедряем.
ENCRYPTION_KEY_VERSION=1
JWT_ACCESS_SECRET=replace-access-secret
JWT_REFRESH_SECRET=replace-refresh-secret

# Число доверенных proxy hop для Express req.ip. Не ставить true: это доверяет любому X-Forwarded-For.
# Render: TRUST_PROXY=1 (один load balancer). Cloudflare+Render: обычно 2. Локально пусто или 0/false.
# Не считать hop=1 универсально верным — сверьте /api/v1/debug/client-ip на staging.
# TRUST_PROXY=1
# Только staging: сравнить req.ip / req.ips / socket.remoteAddress. Не включать в production.
# TRUST_PROXY_DEBUG=1

STORAGE_DRIVER=local
# Локальные загрузки задач: <STORAGE_DIR>/uploads (или ./data/uploads если пусто).
# На Render: Persistent Disk mount /var/data + STORAGE_DIR=/var/data/files (и STORAGE_PERSISTENT=1).
# Без диска файлы КП пропадут после рестарта — /health и Интеграции покажут storePathKind=ephemeral.
STORAGE_DIR=./data/files
# STORAGE_PERSISTENT=1

# Seed только вымышленные данные. Не запускает внешние сообщения.
SEED_PASSWORD=ChangeMeLocal1!

# Администратор сервиса. Пароль не коммитить. Без PLATFORM_ADMIN_PASSWORD учётка не создаётся при старте.
# PLATFORM_ADMIN_EMAIL=you@example.com
# PLATFORM_ADMIN_PASSWORD=

# Мост к существующему WhatsApp ИИ-менеджеру. Пусто = CRM работает без WhatsApp.
# Общий BasQar AI Manager (не URL бота компании).
AI_MANAGER_URL=
WHATSAPP_SELLER_URL=
WHATSAPP_SELLER_SECRET=
# Таймаут отправки файла CRM→бот (мс). Должен быть больше GREEN_API_FILE_TIMEOUT_MS на боте (~100s).
# WHATSAPP_FILE_BRIDGE_TIMEOUT_MS=120000
# Register Integration: POST /internal/crm/integrations/register. Обязателен, не подменяйте секретом компании.
INTERNAL_SERVICE_SECRET=
# Только legacy CREOLAB, пока номер не зарегистрирован как Integration.
# Обратный канал по умолчанию, если Integration не прислала свой URL: CRM_EVENTS_URL на стороне AI Manager.
CRM_BRIDGE_SECRET=

# AI-провайдер не меняем. Ключи только серверные; в mobile public config не класть.
# Те же AnyModel/OpenAI ключи, что у WhatsApp ИИ-менеджера. CRM пишет тексты клиенту сама; репозиторий бота не трогаем.
AI_PROVIDER=
ANYMODEL_API_KEY=
ANYMODEL_BASE_URL=
ANYMODEL_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Push / Telegram — активируются после настройки. Без них уведомления остаются внутри CRM.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
EXPO_ACCESS_TOKEN=

# Письма регистрации и восстановления пароля.
# Без RESEND_API_KEY письмо на Gmail не уходит — в development код показывается на экране.
# Для реальной отправки: ключ Resend + подтверждённый домен в MAIL_FROM.
# RESEND_API_KEY=
# MAIL_FROM=BasQar <noreply@your-domain.com>


# ИС ЭСФ — только системный контур. БИН/ИИН tenant не сюда.
# ESF_AUTH_CERT_PEM не использовать для нового POC: AUTH PEM берётся интерактивно из NCALayer.
# ESF_PROVIDER=live
# ESF_ENV=prod
# ESF_ALLOW_PROD=1
# ESF_ALLOW_LIVE_SEND=1
# ESF_BASE_URL=https://esf.gov.kz:8443/esf-web
# ESF_TEST_API_URL=https://test3.esf.kgd.gov.kz:8443/esf-web
# ESF_PRODUCTION_API_URL=https://esf.gov.kz:8443/esf-web
# ESF_TLS_INSECURE=1
# LEGACY / DEV POC ONLY. Не для multi-tenant production.
# ESF_LEGACY_POC_ENABLED=1
# ESF_ALLOW_SERVER_P12=1
# ESF_SIGN_CERT_PATH=
# ESF_SIGN_CERT_PIN=
# ESF_LOCAL_SERVICE_URL=http://127.0.0.1:6666
# ESF_SDK_DIR=

# Проверка CMS GOST для договоров. Пусто = только разбор сертификата, без криптопроверки.
# Sidecar: java -cp apps/api/kalkan-verify VerifyServer
# Официальные jar НУЦ в KALKAN_LIB_DIR. Не класть .p12 и PIN.
# Docker запускает локальный Kalkan автоматически, когда библиотеки установлены.
# На Render: /var/data/kalkan/lib. См. docs/render-contract-signing.md.
# KALKAN_VERIFY_URL=http://127.0.0.1:4170
# KALKAN_VERIFY_SECRET=
# KALKAN_VERIFY_TIMEOUT_MS=15000
# KALKAN_LIB_DIR=
# KALKAN_VERIFY_PORT=4170
# OCSP/CRL через knca_provider_util из того же SDK. Корни НУЦ — cacerts.jks внутри jar.
# KALKAN_OCSP=1
# KALKAN_OCSP_URL=
# KALKAN_CA_DIR=
# KALKAN_CRL_DIR=

# Google Calendar, Google Forms and incoming Gmail (company Integrations page).
# OAuth client type: Web application. Enable the three APIs in Google Cloud.
# Authorized redirect URI: ${APP_BASE_URL}/api/v1/integrations/google/callback
# Browser OAuth must return to the frontend origin holding its host-only session cookie.
# The app needs a public HTTPS API_BASE_URL for Telegram, Meta and TikTok callbacks.
# Provider access tokens are entered in the company UI and encrypted in Credential.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
