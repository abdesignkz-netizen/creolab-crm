# Domain-only overlay for the EXISTING Render service. Not a complete environment file.
# Apply after bsqr.kz custom domain is verified and HTTPS works. Keep ALL other ENV/secrets.
# If Google OAuth is configured, first allow https://bsqr.kz/api/v1/integrations/google/callback
# in Google Cloud (retain the old callback until all in-flight authorizations expire).
# These are the transitional values: UI migrates, technical callbacks keep their address.
APP_BASE_URL=https://bsqr.kz
API_BASE_URL=https://crm.creolab.kz
ALLOWED_ORIGINS=https://bsqr.kz,https://crm.creolab.kz
# Preserve any other intentionally allowed origins from the existing Dashboard configuration.
LEGACY_APP_ORIGIN=https://crm.creolab.kz
LEGACY_REDIRECT_MODE=ui

# Final stage ONLY after all external senders, saved callbacks, AI Manager and mobile clients
# have stopped using the old API host. Same Render service and database, no backend relocation.
# API_BASE_URL=https://bsqr.kz
# ALLOWED_ORIGINS=https://bsqr.kz
# LEGACY_REDIRECT_MODE=all
# Off disables redirection immediately for rollback; keep old custom domain and TLS throughout.
